{
  "info": {
    "name": "Vitalize Health API",
    "description": "Full collection for the Vitalize Health backend.\n\nAuthentication is cookie-based (httpOnly access + refresh cookies).\nPostman's cookie jar handles them automatically — just call any of the **Login** or **Register** requests first, then run any other request.\n\n- Login is rate-limited to 10 requests/minute per IP; admin auth and registration to 5/min.\n- Content routes require any authenticated user.\n- Admin routes require role = `admin`.\n- Admin registration requires the operator's `ADMIN_INVITE_CODE` (set in `backend/.env`).\n\nDefault base URL: `http://localhost:3005`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "f9c5b3b1-7f24-4d1e-9bdc-c4c7d3e3a001"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3005", "type": "string" },
    { "key": "adminUsername", "value": "admin", "type": "string" },
    { "key": "adminPassword", "value": "vitalize2026", "type": "string" },
    { "key": "readerUsername", "value": "reader", "type": "string" },
    { "key": "readerPassword", "value": "reader2026", "type": "string" },
    { "key": "adminInviteCode", "value": "vitalize-admin-invite-2026", "type": "string" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /api/health",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/health", "host": ["{{baseUrl}}"], "path": ["api", "health"] },
            "description": "Public health probe. Returns `{ status, env }`."
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login as admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('returns userId + role', () => {",
                  "  pm.expect(json).to.have.property('userId');",
                  "  pm.expect(json).to.have.property('role');",
                  "});",
                  "pm.test('role is admin', () => pm.expect(json.role).to.eql('admin'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{adminUsername}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Sets `auth_token` (15m) and `auth_refresh_token` (30d) httpOnly cookies on success.\nResponse body never contains the token — only `{ userId, role }`.\nRate limited: 10 requests / minute / IP."
          }
        },
        {
          "name": "Login as reader",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('role is user', () => pm.expect(pm.response.json().role).to.eql('user'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{readerUsername}}\",\n  \"password\": \"{{readerPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Logs in the demo non-admin user (`reader` / `reader2026`)."
          }
        },
        {
          "name": "Login — invalid credentials (expect 401)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"wrong\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Demonstrates 401 on bad credentials."
          }
        },
        {
          "name": "Register new user",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Generate a unique username so the request can be replayed without 409s.",
                  "pm.collectionVariables.set('signupUsername', 'qa_' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test('role is user', () => pm.expect(json.role).to.eql('user'));",
                  "pm.test('returns userId', () => pm.expect(json).to.have.property('userId'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{signupUsername}}\",\n  \"password\": \"secret123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            },
            "description": "Self-service signup for regular users. Always creates a `role: 'user'` account and immediately signs the user in via httpOnly cookies. Username must be 3–32 chars (letters, digits, `_.-`); password must be 8+ chars. Rate-limited 5/min/IP."
          }
        },
        {
          "name": "Register — duplicate username (expect 409)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{adminUsername}}\",\n  \"password\": \"anything12345\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            },
            "description": "Demonstrates 409 Conflict when the username already exists."
          }
        },
        {
          "name": "Register — weak password (expect 400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"someone_new\",\n  \"password\": \"123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            },
            "description": "Demonstrates 400 with Zod validation details on password too short."
          }
        },
        {
          "name": "Admin login (admin role required)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('role is admin', () => pm.expect(pm.response.json().role).to.eql('admin'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{adminUsername}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/admin/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "admin", "login"]
            },
            "description": "Admin-only login endpoint backing the hidden `/admin/login` UI page. Same credential check as `/login` but returns 403 if the account's role is not admin. Rate-limited 5/min/IP."
          }
        },
        {
          "name": "Admin login — non-admin account (expect 403)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{readerUsername}}\",\n  \"password\": \"{{readerPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/admin/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "admin", "login"]
            },
            "description": "Demonstrates that regular users CANNOT use the admin login endpoint, even with valid credentials."
          }
        },
        {
          "name": "Admin register (requires invite code)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('newAdminUsername', 'qa_admin_' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('role is admin', () => pm.expect(pm.response.json().role).to.eql('admin'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{newAdminUsername}}\",\n  \"password\": \"secret123\",\n  \"inviteCode\": \"{{adminInviteCode}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/admin/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "admin", "register"]
            },
            "description": "Self-service signup for **admin** accounts via the hidden `/admin/register` page. The `inviteCode` body field MUST equal `ADMIN_INVITE_CODE` from `backend/.env` — without it the request returns 403. Rate-limited 5/min/IP."
          }
        },
        {
          "name": "Admin register — bad invite code (expect 403)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"bogus_admin\",\n  \"password\": \"secret123\",\n  \"inviteCode\": \"definitely-wrong\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/admin/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "admin", "register"]
            },
            "description": "Demonstrates that knowing the URL is not enough — the invite code is required."
          }
        },
        {
